# syntax=docker/dockerfile:1.29.0@sha256:572cebbc2b15e6f84c077742952674889cb63cd5e9b80abdffcbe587b6f19183
# versions must match the config/.*-version files (CI checks the drift), refresh pins with scripts/docker/update-pins.sh
FROM dart:3.14.0@sha256:c78970229c8944bd6076caf4e5977ef569ba66750d301a2149f63b41a6725cec AS dart-builder
FROM mcr.microsoft.com/dotnet/sdk:11.0.100@sha256:65f3c7c6a25a239ab3e6719f2896147e7b68242ff2d8818dd70498bde6ef8bea AS csharp-builder
FROM golang:1.27.4-alpine@sha256:70bd7ddea8b6cbe5d6943cde279d6b67feb10cc924fb9100d1d8757c1575b280 AS go-builder
FROM python:3.11.13-trixie@sha256:16e9aaa3fdc728525d4bf3ce02fc311a18c87222005facc3e3c2a5795d297fe1 AS python-builder
FROM composer:2.11.2@sha256:5bcb28b8d0edc4091125f8218f9d088f998bdfc843f8fbb9a4beb4dcd8625684 AS composer-builder
FROM php:8.5.12-trixie@sha256:50956f094e90a716d43bea28087d447555ad80510e386ab8c9c10d8c70d781a9 AS builder

SHELL ["/bin/bash", "--login", "-c"]

# Global dependencies
RUN apt-get update \
  && apt-get install -y --no-install-recommends git curl zip unzip libexpat1-dev libicu76 \
  # for killall and ps, and lsof for finding the port
  && apt-get install -y procps lsof \
  && apt-get clean \
  && rm -rf /var/lib/apt/lists/*

COPY .nvmrc .nvmrc
# the installer is fetched by the commit of its release tag, which cannot change under it
# renovate: datasource=github-tags depName=nvm-sh/nvm
ARG NVM_PIN=v0.41.0@4e8758a801eea9479b32a904f31093e410ddaba4
RUN curl -sSfL --retry 3 -o /tmp/nvm-install.sh "https://raw.githubusercontent.com/nvm-sh/nvm/${NVM_PIN#*@}/install.sh" \
  && bash /tmp/nvm-install.sh && rm /tmp/nvm-install.sh && source ~/.profile \
  && nvm install \
  && npm install -g yarn

# SDKMAN, the installer is vendored (get.sdkman.io serves a mutable script) and verifies the sha256 of the archives it downloads
ARG JAVA_VERSION
COPY scripts/docker/sdkman-install.sh /tmp/sdkman-install.sh
RUN bash /tmp/sdkman-install.sh && rm /tmp/sdkman-install.sh
RUN source "/root/.sdkman/bin/sdkman-init.sh" \
  && sdk install java ${JAVA_VERSION}-zulu \
  && sdk install sbt

# Java formatter
# renovate: datasource=github-release-attachments depName=google/google-java-format asset=google-java-format-{version}-all-deps.jar
ARG JAVA_FORMATTER_PIN=v1.37.0@834b2a0c38cb774953322a84b5ca3f2f40dd3156650b3cd44d3b744345962f7a
RUN version="${JAVA_FORMATTER_PIN%@*}" \
  && curl -sSfL --retry 3 -o /tmp/java-formatter.jar "https://github.com/google/google-java-format/releases/download/${version}/google-java-format-${version#v}-all-deps.jar" \
  && echo "${JAVA_FORMATTER_PIN#*@}  /tmp/java-formatter.jar" | sha256sum -c -


# Python
COPY --from=python-builder /usr/local/bin/ /usr/local/bin/
COPY --from=python-builder /usr/local/lib/ /usr/local/lib/
RUN echo "export PATH=$PATH:/usr/local/bin/python" >> ~/.profile \
  && echo "export PATH=$PATH:/usr/local/bin/pip" >> ~/.profile \
  && pip install --upgrade pip pipx && pipx ensurepath \
  && pipx install poetry==2
ENV VIRTUAL_ENV=/opt/env
RUN python -m venv $VIRTUAL_ENV
ENV PATH="$VIRTUAL_ENV/bin:$PATH"

# Go
COPY --from=go-builder /usr/local/go/ /usr/local/go/
# the installer is fetched by commit like nvm above, then checks the release archive against the release checksums
# renovate: datasource=github-tags depName=golangci/golangci-lint
ARG GOLANGCI_LINT_PIN=v2.15.0@25c5369a93aacb8cccea0d46e1569ca4a194564d
RUN echo "export PATH=$PATH:/usr/local/go/bin:/root/go/bin" >> ~/.profile && source ~/.profile \
  && curl -sSfL --retry 3 -o /tmp/golangci-install.sh "https://raw.githubusercontent.com/golangci/golangci-lint/${GOLANGCI_LINT_PIN#*@}/install.sh" \
  && sh /tmp/golangci-install.sh -b $(go env GOPATH)/bin "${GOLANGCI_LINT_PIN%@*}" && rm /tmp/golangci-install.sh \
  && go install golang.org/x/tools/cmd/goimports@v0.22.0

# Dart
COPY --from=dart-builder /usr/lib/dart/ /usr/lib/dart/
RUN echo "export PATH=/usr/lib/dart/bin:/root/.pub-cache/bin:$PATH" >> ~/.profile && source ~/.profile \
  && dart pub global activate melos

# PHP
COPY --from=composer-builder /usr/bin/composer /usr/local/bin/composer

# C#
COPY --from=csharp-builder /usr/share/dotnet /usr/share/dotnet
RUN echo "export PATH=$PATH:/usr/share/dotnet:/root/.dotnet/tools" >> ~/.profile && source ~/.profile

WORKDIR /app
