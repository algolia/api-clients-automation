# syntax=docker/dockerfile:1.26.0@sha256:ecfaec9ed6d810b56388c508f4121597bfbba70d41a6dfeee4d8cad5f295fc32
# versions must match the config/.*-version files (CI checks the drift), refresh pins with scripts/docker/update-pins.sh
FROM dart:3.11.6@sha256:2ed474dc085f267ca692261ce35b23a0ae039e317beebef854be886c8b57832d AS dart-builder
FROM mcr.microsoft.com/dotnet/sdk:10.0.400@sha256:e1ffd2a92ae84c1291bc1b6887501f8af98e6331e7af6d4c8d37168c5e87a64c AS csharp-builder
FROM golang:1.27.0-alpine@sha256:4c9fe60190a2a3350ddc51de80d0224b8a6698d12bdfc999fee45ea9d6c46dbc AS go-builder
FROM python:3.11.13-trixie@sha256:16e9aaa3fdc728525d4bf3ce02fc311a18c87222005facc3e3c2a5795d297fe1 AS python-builder
FROM composer:2.10.2@sha256:d020706319701a44468968321dccd0fce6620190159a7a9ec195d78e6e971c71 AS composer-builder
FROM php:8.5.9-trixie@sha256:0e17ef0527f296b85bfe4cfb5219b29cafc37224857ed73d28628ea142930ac8 AS builder

SHELL ["/bin/bash", "--login", "-c"]

# Global dependencies
RUN apt-get update \
  && apt-get install -y --no-install-recommends git curl zip unzip libexpat1-dev libicu76 \
  # for killall and ps, and lsof for finding the port
  && apt-get install -y procps lsof \
  && apt-get clean \
  && rm -rf /var/lib/apt/lists/*

COPY .nvmrc .nvmrc
RUN curl -sSfL --retry 3 -o /tmp/nvm-install.sh https://raw.githubusercontent.com/nvm-sh/nvm/v0.39.7/install.sh \
  && echo "8e45fa547f428e9196a5613efad3bfa4d4608b74ca870f930090598f5af5f643  /tmp/nvm-install.sh" | sha256sum -c - \
  && bash /tmp/nvm-install.sh && rm /tmp/nvm-install.sh && source ~/.profile \
  && nvm install \
  && npm install -g yarn@1.22.22

# SDKMAN, the installer is vendored (get.sdkman.io serves a mutable script), it still downloads the sdkman-cli archive itself
ARG JAVA_VERSION
COPY scripts/docker/sdkman-install.sh /tmp/sdkman-install.sh
RUN bash /tmp/sdkman-install.sh && rm /tmp/sdkman-install.sh
RUN source "/root/.sdkman/bin/sdkman-init.sh" \
  && sdk install java ${JAVA_VERSION}-zulu \
  && sdk install sbt 2.0.6

# Java formatter
ADD --checksum=sha256:25b400f003089d23cc5320cdaf1a16cabee19b8aa3434d0ff021b3d9f42154b4 https://github.com/google/google-java-format/releases/download/v1.36.1/google-java-format-1.36.1-all-deps.jar /tmp/java-formatter.jar


# Python
COPY --from=python-builder /usr/local/bin/ /usr/local/bin/
COPY --from=python-builder /usr/local/lib/ /usr/local/lib/
RUN echo "export PATH=$PATH:/usr/local/bin/python" >> ~/.profile \
  && echo "export PATH=$PATH:/usr/local/bin/pip" >> ~/.profile \
  && pip install --upgrade pip==26.2.1 pipx==1.16.7 && pipx ensurepath \
  && pipx install poetry==2.4.2
ENV VIRTUAL_ENV=/opt/env
RUN python -m venv $VIRTUAL_ENV
ENV PATH="$VIRTUAL_ENV/bin:$PATH"

# Go
COPY --from=go-builder /usr/local/go/ /usr/local/go/
RUN echo "export PATH=$PATH:/usr/local/go/bin:/root/go/bin" >> ~/.profile && source ~/.profile \
  && curl -sSfL --retry 3 -o /tmp/golangci-install.sh https://raw.githubusercontent.com/golangci/golangci-lint/v2.10.1/install.sh \
  && echo "edfa587f31bde70db161d1e5b783e086a1627d7e2f7c91de5f7cca79bcdf8631  /tmp/golangci-install.sh" | sha256sum -c - \
  && sh /tmp/golangci-install.sh -b $(go env GOPATH)/bin v2.10.1 && rm /tmp/golangci-install.sh \
  && go install golang.org/x/tools/cmd/goimports@v0.22.0

# Dart
COPY --from=dart-builder /usr/lib/dart/ /usr/lib/dart/
RUN echo "export PATH=/usr/lib/dart/bin:/root/.pub-cache/bin:$PATH" >> ~/.profile && source ~/.profile \
  && dart pub global activate melos 8.6.0

# PHP
COPY --from=composer-builder /usr/bin/composer /usr/local/bin/composer

# C#
COPY --from=csharp-builder /usr/share/dotnet /usr/share/dotnet
RUN echo "export PATH=$PATH:/usr/share/dotnet:/root/.dotnet/tools" >> ~/.profile && source ~/.profile

WORKDIR /app
