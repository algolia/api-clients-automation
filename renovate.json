{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:js-app",
    "github>algolia/renovate-config-algolia",
    ":preserveSemverRanges",
    "helpers:pinGitHubActionDigests"
  ],
  "enabledManagers": [
    "bundler",
    "dockerfile",
    "github-actions",
    "gomod",
    "gradle-wrapper",
    "gradle",
    "npm",
    "nuget",
    "nvm",
    "pip_requirements",
    "poetry",
    "pub",
    "custom.regex",
    "sbt"
  ],
  "minimumReleaseAge": "3 days",
  "baseBranches": [
    "chore/renovateBaseBranch"
  ],
  "postUpdateOptions": [
    "gomodTidy"
  ],
  "packageRules": [
    {
      "description": "Keep the docker image digests in scripts/docker/ pinned and up to date",
      "matchDatasources": [
        "docker"
      ],
      "matchFileNames": [
        "scripts/docker/**"
      ],
      "pinDigests": true
    },
    {
      "description": "The language image versions are governed by the config/.*-version files, only keep their digests fresh",
      "matchDatasources": [
        "docker"
      ],
      "matchPackageNames": [
        "dart",
        "mcr.microsoft.com/dotnet/sdk",
        "golang",
        "python",
        "php",
        "ruby",
        "swift"
      ],
      "matchUpdateTypes": [
        "major",
        "minor",
        "patch"
      ],
      "enabled": false
    },
    {
      "description": "Update the swiftformat docker image and the CI source build together",
      "groupName": "swiftformat",
      "matchPackageNames": [
        "nicklockwood/SwiftFormat",
        "ghcr.io/nicklockwood/swiftformat"
      ]
    },
    {
      "matchDepTypes": [
        "required_provider"
      ],
      "rangeStrategy": "bump"
    },
    {
      "groupName": "openapi-generator",
      "matchPackageNames": [
        "/openapi-generator/"
      ]
    },
    {
      "allowedVersions": "4.0.0",
      "matchPackageNames": [
        "github.com/algolia/algoliasearch-client-go/v4"
      ]
    },
    {
      "matchDatasources": [
        "dart-version"
      ],
      "allowedVersions": "/^[0-9]+\\.[0-9]+\\.[0-9]+$/"
    },
    {
      "description": "The PyPI release toolchain (poetry/twine) is not compatible with Python 3.14+, which breaks publishing. Keep the Python release workflow on the 3.13.x line.",
      "matchManagers": [
        "github-actions"
      ],
      "matchDepNames": [
        "python"
      ],
      "allowedVersions": "<3.14"
    }
  ],
  "customManagers": [
    {
      "customType": "regex",
      "description": "Update openapitools-cli version in the generation file",
      "managerFilePatterns": [
        "/generateOpenapitools.ts/"
      ],
      "matchStrings": [
        "\\sversion: '(?<currentValue>.*?)',?\\s"
      ],
      "depNameTemplate": "org.openapitools:openapi-generator-cli",
      "datasourceTemplate": "maven"
    },
    {
      "customType": "regex",
      "description": "Update pyproject.toml mustache devDeps",
      "managerFilePatterns": [
        "/pyproject.mustache/"
      ],
      "matchStrings": [
        "dependencies][^[]*",
        "(?<depName>.*?)=\\s*\"(?<currentValue>.*?)\""
      ],
      "matchStringsStrategy": "recursive",
      "datasourceTemplate": "pypi"
    },
    {
      "customType": "regex",
      "description": "Update package.json mustache devDeps",
      "managerFilePatterns": [
        "/package.mustache/"
      ],
      "matchStrings": [
        "\"(?<depName>.*?)\":\\s*\"(?<currentValue>\\d+.*?)\""
      ],
      "datasourceTemplate": "npm"
    },
    {
      "customType": "regex",
      "description": "Update golangci-lint in the docker images; action.yml is managed in #6942",
      "managerFilePatterns": [
        "/Dockerfile/"
      ],
      "matchStrings": [
        "golangci-lint/v(?<currentValue>[0-9.]+)/install\\.sh",
        "golangci-install\\.sh -b .+ v(?<currentValue>[0-9.]+)"
      ],
      "depNameTemplate": "golangci/golangci-lint",
      "datasourceTemplate": "github-releases",
      "extractVersionTemplate": "^v(?<version>.*)$"
    },
    {
      "customType": "regex",
      "description": "Update nvm, the checksum next to it must be refreshed with scripts/docker/update-pins.sh",
      "managerFilePatterns": [
        "/Dockerfile/"
      ],
      "matchStrings": [
        "nvm-sh/nvm/v(?<currentValue>[0-9.]+)/install\\.sh"
      ],
      "depNameTemplate": "nvm-sh/nvm",
      "datasourceTemplate": "github-releases",
      "extractVersionTemplate": "^v(?<version>.*)$"
    },
    {
      "customType": "regex",
      "description": "Update the java formatter, the checksums next to it must be refreshed with scripts/docker/update-pins.sh",
      "managerFilePatterns": [
        "/Dockerfile/",
        "/.github/actions/setup/action.yml/"
      ],
      "matchStrings": [
        "google-java-format/releases/download/v(?<currentValue>.*?)/google-java-format-",
        "google-java-format/releases/download/v(.*?)/google-java-format-(?<currentValue>.*?)-all-deps"
      ],
      "depNameTemplate": "google/google-java-format",
      "datasourceTemplate": "github-releases",
      "extractVersionTemplate": "^v(?<version>.*)$"
    },
    {
      "customType": "regex",
      "description": "Update java packages in mustache files",
      "managerFilePatterns": [
        "/build.mustache/"
      ],
      "matchStrings": [
        "testImplementation '(?<depName>.*):(?<currentValue>\\d.*?)'"
      ],
      "datasourceTemplate": "maven"
    },
    {
      "customType": "regex",
      "description": "Update yarn version",
      "managerFilePatterns": [
        "/.yarnrc.yml/"
      ],
      "matchStrings": [
        ".yarn/releases/yarn-(?<currentValue>.*?)\\.cjs"
      ],
      "depNameTemplate": "yarnpkg/berry",
      "datasourceTemplate": "github-releases"
    },
    {
      "customType": "regex",
      "description": "Update yarn for netlify",
      "managerFilePatterns": [
        "/netlify.toml/"
      ],
      "matchStrings": [
        "YARN_VERSION\\s*=\\s*\"(?<currentValue>.*?)\""
      ],
      "depNameTemplate": "yarnpkg/berry",
      "datasourceTemplate": "github-releases"
    },
    {
      "customType": "regex",
      "description": "Update pubspec.yaml for Dart",
      "managerFilePatterns": [
        "/pubspec.mustache/"
      ],
      "matchStrings": [
        "(dev_)?dependencies:\\s*[^$]*",
        "  (?<depName>[a-z_]+?): (?<currentValue>.*?)\n"
      ],
      "matchStringsStrategy": "recursive",
      "datasourceTemplate": "dart",
      "versioningTemplate": "npm"
    },
    {
      "customType": "regex",
      "description": "Update .csharp-version",
      "managerFilePatterns": [
        "/.csharp-version/"
      ],
      "matchStrings": [
        "(?<currentValue>.*)"
      ],
      "datasourceTemplate": "dotnet-version",
      "depNameTemplate": "dotnet-sdk"
    },
    {
      "customType": "regex",
      "description": "Update .java-version",
      "managerFilePatterns": [
        "/.java-version/"
      ],
      "matchStrings": [
        "(?<currentValue>.*)"
      ],
      "datasourceTemplate": "java-version",
      "depNameTemplate": "java"
    },
    {
      "customType": "regex",
      "description": "Update .dart-version",
      "managerFilePatterns": [
        "/.dart-version/"
      ],
      "matchStrings": [
        "(?<currentValue>.*)"
      ],
      "datasourceTemplate": "dart-version",
      "depNameTemplate": "dart"
    },
    {
      "customType": "regex",
      "description": "Update .go-version",
      "managerFilePatterns": [
        "/.go-version/"
      ],
      "matchStrings": [
        "(?<currentValue>.*)"
      ],
      "datasourceTemplate": "golang-version",
      "depNameTemplate": "golang"
    },
    {
      "customType": "regex",
      "description": "Update .php-version",
      "managerFilePatterns": [
        "/.php-version/"
      ],
      "matchStrings": [
        "(?<currentValue>.*)"
      ],
      "datasourceTemplate": "github-tags",
      "depNameTemplate": "php/php-src",
      "extractVersionTemplate": "^php-(?<version>.*)$"
    },
    {
      "customType": "regex",
      "description": "Update .ruby-version",
      "managerFilePatterns": [
        "/.ruby-version/"
      ],
      "matchStrings": [
        "(?<currentValue>.*)"
      ],
      "datasourceTemplate": "ruby-version",
      "depNameTemplate": "ruby"
    },
    {
      "customType": "regex",
      "description": "Update ruby version on CI",
      "managerFilePatterns": [
        "/clients/algoliasearch-client-ruby/.github/workflows/release.yml/"
      ],
      "matchStrings": [
        "ruby-version: (?<currentValue>.*)"
      ],
      "datasourceTemplate": "ruby-version",
      "depNameTemplate": "ruby"
    },
    {
      "customType": "regex",
      "description": "Update .swift-version",
      "managerFilePatterns": [
        "/.swift-version/"
      ],
      "matchStrings": [
        "(?<currentValue>.*)"
      ],
      "datasourceTemplate": "github-releases",
      "depNameTemplate": "swiftlang/swift",
      "extractVersionTemplate": "^swift-(?<version>.*)-RELEASE$"
    },
    {
      "customType": "regex",
      "description": "Update swiftformat version",
      "managerFilePatterns": [
        "/Dockerfile/",
        "/.github/actions/setup/action.yml/"
      ],
      "matchStrings": [
        "SWIFTFORMAT_VERSION=(?<currentValue>\\d+\\.\\d+\\.\\d+)"
      ],
      "depNameTemplate": "nicklockwood/SwiftFormat",
      "datasourceTemplate": "github-releases"
    },
    {
      "customType": "regex",
      "description": "Update the yarn bootstrap in the base docker image",
      "managerFilePatterns": [
        "/Dockerfile/"
      ],
      "matchStrings": [
        "npm install -g yarn@(?<currentValue>[0-9.]+)"
      ],
      "depNameTemplate": "yarn",
      "datasourceTemplate": "npm"
    },
    {
      "customType": "regex",
      "description": "Update sbt in the base docker image",
      "managerFilePatterns": [
        "/Dockerfile/"
      ],
      "matchStrings": [
        "sdk install sbt (?<currentValue>[0-9.]+)"
      ],
      "depNameTemplate": "sbt/sbt",
      "datasourceTemplate": "github-releases",
      "extractVersionTemplate": "^v(?<version>.*)$"
    },
    {
      "customType": "regex",
      "description": "Update melos in the docker images; action.yml is managed in #6942",
      "managerFilePatterns": [
        "/Dockerfile/"
      ],
      "matchStrings": [
        "dart pub global activate melos (?<currentValue>[0-9.]+)"
      ],
      "depNameTemplate": "melos",
      "datasourceTemplate": "dart"
    },
    {
      "customType": "regex",
      "description": "Update poetry in the docker images; action.yml is managed in #6942",
      "managerFilePatterns": [
        "/Dockerfile/"
      ],
      "matchStrings": [
        "pipx install poetry==(?<currentValue>[0-9]+\\.[0-9.]+)"
      ],
      "depNameTemplate": "poetry",
      "datasourceTemplate": "pypi"
    },
    {
      "customType": "regex",
      "description": "Update pip in the base docker image",
      "managerFilePatterns": [
        "/Dockerfile/"
      ],
      "matchStrings": [
        "pip install --upgrade pip==(?<currentValue>[0-9.]+)"
      ],
      "depNameTemplate": "pip",
      "datasourceTemplate": "pypi"
    },
    {
      "customType": "regex",
      "description": "Update pipx in the base docker image",
      "managerFilePatterns": [
        "/Dockerfile/"
      ],
      "matchStrings": [
        "pipx==(?<currentValue>[0-9.]+)"
      ],
      "depNameTemplate": "pipx",
      "datasourceTemplate": "pypi"
    }
  ],
  "github-actions": {
    "managerFilePatterns": [
      "/\\.github/workflows/.*\\.ya?ml$/",
      "/\\.github/actions/.*/action\\.ya?ml$/",
      "/^templates/.*\\.ya?ml$/"
    ]
  },
  "ignorePaths": [
    "**/algoliasearch/**",
    "**/client-abtesting/**",
    "**/client-agent-studio/**",
    "**/client-analytics/**",
    "**/client-insights/**",
    "**/client_insights/**",
    "**/client-personalization/**",
    "**/client-query-suggestions/**",
    "**/client-search/**",
    "**/client_search/**",
    "**/ingestion/**",
    "**/monitoring/**",
    "**/recommend/**",
    "clients/algoliasearch-client-php/composer.json",
    "tests/output/dart/**",
    "tests/output/java/**",
    "tests/output/javascript/package.json",
    "docs/**"
  ],
  "prHourlyLimit": 20,
  "prConcurrentLimit": 50,
  "prCreation": "immediate"
}
